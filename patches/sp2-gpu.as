      private function gpuMatrix(matrix:Matrix3D) : Array
      {
         var raw:Vector.<Number> = matrix.rawData;
         var values:Array = [];
         for(var i:int = 0; i < 16; i++) values.push(raw[i]);
         return values;
      }

      private function collectGpuObjects(object:Object3D, parent:Matrix3D, opacity:Number, output:Array) : void
      {
         if(!object.visible || object == this.coreInterface.camera) return;
         opacity *= object.alpha;
         if(opacity <= 0.001) return;
         var world:Matrix3D = parent.clone();
         world.prepend(object.matrix);
         if(object is Mesh)
         {
            output.push({name:getQualifiedClassName(object),matrix:this.gpuMatrix(world),alpha:opacity});
         }
         else if(object is Sprite3D)
         {
            var sprite:Sprite3D = object as Sprite3D;
            var material:TextureMaterial = sprite.material as TextureMaterial;
            var dark:Boolean = false;
            if(material != null && material.texture != null)
               dark = material.texture.getPixel(material.texture.width / 2,material.texture.height / 2) < 8421504;
            output.push({sprite:true,dark:dark,matrix:this.gpuMatrix(world),alpha:opacity,width:sprite.width,height:sprite.height,rotation:sprite.rotation});
         }
         if(object is Object3DContainer)
         {
            var container:Object3DContainer = object as Object3DContainer;
            for(var i:int = 0; i < container.numChildren; i++)
               this.collectGpuObjects(container.getChildAt(i),world,opacity,output);
         }
      }

      private function renderGameFrame() : void
      {
         this.layoutResponsiveUI();
         if(!this.gpuEnabled)
         {
            this.coreInterface.camera.render();
            return;
         }
         var objects:Array = [];
         this.collectGpuObjects(this.coreInterface.sceneRoot,new Matrix3D(),1,objects);
         ExternalInterface.call("stuntGpuFrame",objects,this.gpuMatrix(this.coreInterface.cameraMatrix),this.coreInterface.camera.fov,stage.stageWidth,stage.stageHeight,this.gameState);
      }

      private function prepareStaticScenery() : void
      {
         var scene:BSPContainer = this.coreInterface.sceneRoot as BSPContainer;
         if(scene == null) return;
         var scenery:Vector.<Geometry> = new Vector.<Geometry>();
         for each(var mesh:Mesh in this.models)
         {
            if(mesh == this.ringIndicator) continue;
            var geometry:Geometry = mesh.geometry.clone();
            geometry.transform(mesh.matrix);
            scenery.push(geometry);
         }
         scene.createTree(scenery);
         for each(var staticMesh:Mesh in this.models)
         {
            if(staticMesh != this.ringIndicator && staticMesh.parent == scene) scene.removeChild(staticMesh);
         }
      }
      private function addMeshToLevel(mesh:Mesh, bsp:Boolean) : void
      {
         if(bsp)
         {
            mesh.sorting = Sorting.DYNAMIC_BSP;
            mesh.optimizeForDynamicBSP();
         }
         this.coreInterface.sceneRoot.addChild(mesh);
         this.models.push(mesh);
      }
      
