      protected function startGame() : void
      {
         this.coreInterface.paused = false;
         this.coreInterface.masterVolume = 0;
         if(this.gpuEnabled)
         {
            // GPU assets are already uploaded before the SWF starts.
            // Build the level directly and enter the normal fade/countdown.
            this.createLevel(this.levelNum);
            gfxCount.gotoAndStop(1);
            this.coreInterface.physics.engine.integrate(0.12);
            this._player.update(0);
            this.updateCamera(1);
            this.updateStats(0);
            this._frameCounter = 0;
            this.finishLevelPreparation();
            stage.focus = this;
            return;
         }
         this.gameState = LEVEL_LOADING;
         this.levelLoadingFrames = 0;
         this.levelLoadingOverlay = new Sprite();
         this.levelLoadingText = new TextField();
         this.levelLoadingText.defaultTextFormat = new TextFormat("_sans",22,0xFFFFFF,true);
         this.levelLoadingText.autoSize = TextFieldAutoSize.LEFT;
         this.levelLoadingText.selectable = false;
         this.levelLoadingText.mouseEnabled = false;
         this.levelLoadingText.text = "Preparing level...";
         this.levelLoadingOverlay.addChild(this.levelLoadingText);
         addChild(this.levelLoadingOverlay);
         this.layoutLevelLoading();
         stage.focus = this;
      }

      private function layoutLevelLoading() : void
      {
         if(this.levelLoadingOverlay == null) return;
         this.levelLoadingOverlay.graphics.clear();
         this.levelLoadingOverlay.graphics.beginFill(0x172433);
         this.levelLoadingOverlay.graphics.drawRect(0,0,stage.stageWidth,stage.stageHeight);
         this.levelLoadingOverlay.graphics.endFill();
         this.levelLoadingText.x = (stage.stageWidth - this.levelLoadingText.width) / 2;
         this.levelLoadingText.y = (stage.stageHeight - this.levelLoadingText.height) / 2;
      }

      private function prepareLevelFrame() : void
      {
         ++this.levelLoadingFrames;
         // Allow the loading screen to paint before synchronous mesh creation.
         if(this.levelLoadingFrames < 3) return;
         if(this.levelLoadingFrames == 3)
         {
            this.createLevel(this.levelNum);
            if(!this.gpuEnabled) this.prepareStaticScenery();
            gfxCount.gotoAndStop(1);
            this.coreInterface.physics.engine.integrate(0.12);
            this._player.update(0);
            this.updateCamera(1);
            this.updateStats(0);
            this._frameCounter = 0;
            this.levelLoadingText.text = "Preparing graphics...";
            this.layoutLevelLoading();
            setChildIndex(this.levelLoadingOverlay,numChildren - 1);
         }
         // Exercise the real camera/material path across nine display frames.
         // Keep the plane, countdown and level timer frozen while warming it.
         this.renderGameFrame();
         if(this.levelLoadingFrames < 11) return;
         removeChild(this.levelLoadingOverlay);
         this.levelLoadingOverlay = null;
         this.levelLoadingText = null;
         this.finishLevelPreparation();
      }

      private function finishLevelPreparation() : void
      {
         this._player.resetControl();
         this.gameState = core_gamestate.GAMEFADEIN;
         this.updateCamera(1);
         this.coreInterface.masterVolume = 1;
         this.last_time = new Date().getTime();
         gfxCount.gotoAndPlay(1);
         if(this.gpuEnabled)
         {
            // A prepared GPU level can reveal its countdown immediately.
            if(gfxFader.parent == this) removeChild(gfxFader);
            gfxFader.alpha = 0;
         }
         else this.prepareFadeFromBlack();
      }
      protected function stopGame(aborted:Boolean) : void
      {
         if(this.startLampActive)
         {
            removeChild(gfxCount);
         }
         removeChild(gfxHud);
         while(Boolean(this.checkPoints.length))
         {
            this.checkPoints.pop();
         }
         removeChild(gfxArrow);
         if(this.coreInterface.paused)
         {
            this.togglePause();
         }
         this._player.remove();
         this.coreInterface.destroyExcluders();
         this.removeModels();
         if(aborted)
         {
            this.processFrontend(true);
         }
      }
      
      protected function togglePause() : void
      {
         this.coreInterface.paused = !this.coreInterface.paused;
         if(this.coreInterface.paused)
         {
            if(this.gpuEnabled) gfxPaused = this.makePausePanel();
            addChild(gfxPaused);
            this._player.setEngineVolume(true);
            gfxPaused.getChildByName("btn_mainmenu").addEventListener(MouseEvent.CLICK,this.onPauseAbort);
            this.removeStoreButtons(gfxPaused);
            gfxPaused.getChildByName("btn_retry").addEventListener(MouseEvent.CLICK,this.onPauseRetry);
            if(this.startLampActive)
            {
               gfxCount.stop();
            }
         }
         else
         {
            removeChild(gfxPaused);
            this._player.setEngineVolume(false);
            if(this.startLampActive)
            {
               gfxCount.play();
            }
            stage.focus = this;
         }
      }
      
      private function onPauseAbort(e:MouseEvent) : void
      {
         this.stopGame(true);
      }
      
      private function onPauseRetry(e:MouseEvent) : void
      {
         this.stopGame(false);
         this.reset();
         this.startGame();
      }
      
      // Camera compatibility: explicit +Z-forward / -Y-up camera basis.
      // Avoid Matrix3D.pointAt and quaternion recompose stubs in Ruffle.
      private function pointCamera(matrix:Matrix3D, target:Vector3D) : void
      {
         var position:Vector3D = matrix.position;
         var forward:Vector3D = target.subtract(position);
         if(forward.normalize() < 0.000001) return;
         var right:Vector3D = forward.crossProduct(Vector3D.Y_AXIS);
         if(right.normalize() < 0.000001) right = new Vector3D(1,0,0);
         var down:Vector3D = forward.crossProduct(right);
         down.normalize();
         matrix.rawData = new <Number>[right.x,right.y,right.z,0,down.x,down.y,down.z,0,forward.x,forward.y,forward.z,0,position.x,position.y,position.z,1];
      }

      private function blendCamera(target:Matrix3D, amount:Number) : void
      {
         var current:Matrix3D = this.coreInterface.cameraMatrix;
         if(amount >= 1) { current.rawData = target.rawData; return; }
         var a:Vector3D = current.decompose(Orientation3D.QUATERNION)[1];
         var b:Vector3D = target.decompose(Orientation3D.QUATERNION)[1];
         var dot:Number = a.x*b.x+a.y*b.y+a.z*b.z+a.w*b.w;
         if(dot < 0) { b.x=-b.x; b.y=-b.y; b.z=-b.z; b.w=-b.w; dot=-dot; }
         var wa:Number = 1-amount;
         var wb:Number = amount;
         if(dot < 0.9995) {
            var angle:Number = Math.acos(Math.min(1,dot));
            var sine:Number = Math.sin(angle);
            wa = Math.sin((1-amount)*angle)/sine;
            wb = Math.sin(amount*angle)/sine;
         }
         var x:Number=wa*a.x+wb*b.x;
         var y:Number=wa*a.y+wb*b.y;
         var z:Number=wa*a.z+wb*b.z;
         var w:Number=wa*a.w+wb*b.w;
         var length:Number=Math.sqrt(x*x+y*y+z*z+w*w);
         x/=length; y/=length; z/=length; w/=length;
         var p:Vector3D=current.position;
         var q:Vector3D=target.position;
         current.rawData = new <Number>[
            1-2*(y*y+z*z),2*(x*y+z*w),2*(x*z-y*w),0,
            2*(x*y-z*w),1-2*(x*x+z*z),2*(y*z+x*w),0,
            2*(x*z+y*w),2*(y*z-x*w),1-2*(x*x+y*y),0,
            p.x+(q.x-p.x)*amount,p.y+(q.y-p.y)*amount,p.z+(q.z-p.z)*amount,1];
      }

      // Affine bitmap triangles with adaptive perspective subdivision.
      private static var textureTransform:Matrix = new Matrix();
      public static function drawCompatibleTriangles(g:Graphics, bitmap:BitmapData, vertices:Vector.<Number>, indices:Vector.<int>, uv:Vector.<Number>, repeat:Boolean, smooth:Boolean) : void
      {
         var textureWidth:Number=bitmap.width;
         var textureHeight:Number=bitmap.height;
         g.endFill();
         for(var i:int=0; i<indices.length; i+=3) {
            var a:int=indices[i]; var b:int=indices[i+1]; var c:int=indices[i+2];
            textureTriangle(g,bitmap,repeat,smooth,
               vertices[a*2],vertices[a*2+1],uv[a*3]*textureWidth,uv[a*3+1]*textureHeight,uv[a*3+2],
               vertices[b*2],vertices[b*2+1],uv[b*3]*textureWidth,uv[b*3+1]*textureHeight,uv[b*3+2],
               vertices[c*2],vertices[c*2+1],uv[c*3]*textureWidth,uv[c*3+1]*textureHeight,uv[c*3+2],0);
         }
      }

      private static function textureTriangle(g:Graphics, bitmap:BitmapData, repeat:Boolean, smooth:Boolean,
         ax:Number,ay:Number,au:Number,av:Number,at:Number,
         bx:Number,by:Number,bu:Number,bv:Number,bt:Number,
         cx:Number,cy:Number,cu:Number,cv:Number,ct:Number,depth:int) : void
      {
         var ab:Number=(ax-bx)*(ax-bx)+(ay-by)*(ay-by);
         var bc:Number=(bx-cx)*(bx-cx)+(by-cy)*(by-cy);
         var ca:Number=(cx-ax)*(cx-ax)+(cy-ay)*(cy-ay);
         if(depth<4 && Math.max(ab,bc,ca)>2500) {
            // Rotate the longest edge into AB; preserve triangle winding.
            if(bc>ab && bc>=ca) {
               textureTriangle(g,bitmap,repeat,smooth,bx,by,bu,bv,bt,cx,cy,cu,cv,ct,ax,ay,au,av,at,depth);
               return;
            }
            if(ca>ab && ca>bc) {
               textureTriangle(g,bitmap,repeat,smooth,cx,cy,cu,cv,ct,ax,ay,au,av,at,bx,by,bu,bv,bt,depth);
               return;
            }
            var mt:Number=(at+bt)*0.5;
            var mu:Number=(au*at+bu*bt)/(at+bt);
            var mv:Number=(av*at+bv*bt)/(at+bt);
            if(Math.abs(mu-(au+bu)*0.5)+Math.abs(mv-(av+bv)*0.5)>2) {
               var mx:Number=(ax+bx)*0.5; var my:Number=(ay+by)*0.5;
               textureTriangle(g,bitmap,repeat,smooth,ax,ay,au,av,at,mx,my,mu,mv,mt,cx,cy,cu,cv,ct,depth+1);
               textureTriangle(g,bitmap,repeat,smooth,mx,my,mu,mv,mt,bx,by,bu,bv,bt,cx,cy,cu,cv,ct,depth+1);
               return;
            }
         }
         var du1:Number=bu-au; var dv1:Number=bv-av; var du2:Number=cu-au; var dv2:Number=cv-av;
         var det:Number=du1*dv2-du2*dv1;
         if(Math.abs(det)<0.0000001) return;
         var ma:Number=((bx-ax)*dv2-(cx-ax)*dv1)/det;
         var mb:Number=((by-ay)*dv2-(cy-ay)*dv1)/det;
         var mc:Number=((cx-ax)*du1-(bx-ax)*du2)/det;
         var md:Number=((cy-ay)*du1-(by-ay)*du2)/det;
         var transform:Matrix=textureTransform;
         transform.a=ma; transform.b=mb; transform.c=mc; transform.d=md; transform.tx=ax-ma*au-mc*av; transform.ty=ay-mb*au-md*av;
         g.beginBitmapFill(bitmap,transform,repeat,smooth);
         g.moveTo(ax,ay); g.lineTo(bx,by); g.lineTo(cx,cy); g.lineTo(ax,ay); g.endFill();
      }

      // Avoid Object3D.matrix's ambiguous Euler decomposition at cardinal
      // headings. The first level starts at exactly 90 degrees.
      private function applyCameraMatrix() : void
      {
         var matrix:Matrix3D = this.coreInterface.cameraMatrix;
         var d:Vector.<Number> = matrix.rawData;
         var camera:Camera3D = this.coreInterface.camera;
         camera.x = d[12];
         camera.y = d[13];
         camera.z = d[14];
         var sinY:Number = Math.max(-1,Math.min(1,-d[2]));
         camera.rotationY = Math.asin(sinY);
         if(Math.abs(d[2]) > 0.9999999)
         {
            camera.rotationX = 0;
            camera.rotationZ = Math.atan2(-d[4],d[5]);
         }
         else
         {
            camera.rotationX = Math.atan2(d[6],d[10]);
            camera.rotationZ = Math.atan2(d[1],d[0]);
         }
         camera.scaleX = camera.scaleY = camera.scaleZ = 1;
      }
      protected function updateCamera(smooth:Number) : void
      {
         var m:Matrix3D = new Matrix3D();
         if(this.gameState == core_gamestate.FRONTEND)
         {
            m.position = new Vector3D(-88.6 + Math.sin(this._frameCounter * 0.005),11.785 + Math.sin(this._frameCounter * 0.05),-243.324 + Math.cos(this._frameCounter * 0.05));
            if(scrTitle != null)
            {
               var menuTarget:Vector3D = new Vector3D(33.582,25.518,-140.937);
               if(this.gpuEnabled)
               {
                  // Reframe the hangar to leave the logo its own space.
                  // Move camera and aim together, preserving the aircraft angle.
                  var menuOffset:Vector3D = new Vector3D(24,8,-29);
                  m.position = m.position.add(menuOffset);
                  menuTarget.incrementBy(menuOffset);
               }
               this.pointCamera(m,menuTarget);
            }
            else if(scrInstructions != null)
            {
               this.pointCamera(m,new Vector3D(-108.428,15.937,-199.664));
            }
            this.blendCamera(m,smooth);
            this.applyCameraMatrix();
            return;
         }
         var p:Vector3D = this._player.mtx.position.clone();
         var axisz:Vector3D = new Vector3D(this._player.mtx.rawData[8],this._player.mtx.rawData[9],this._player.mtx.rawData[10]);
         if(this.gameState == core_gamestate.ENDGAME)
         {
            p.y += 200;
            p.x += 200;
            p.z += 200;
            if(p.y < 100)
            {
               p.y = 100;
            }
         }
         else
         {
            axisz.scaleBy(-90);
            p.incrementBy(axisz);
            p.y += 40;
         }
         m.position = p;
         var t:Vector3D = this._player.mtx.position.clone();
         if(this.gameState != core_gamestate.ENDGAME)
         {
            t.decrementBy(axisz);
         }
         this.pointCamera(m,t);
         if(smooth >= 1 && this.gameState != core_gamestate.ENDGAME)
         {
            // Normal flight moves 150 * 0.12 units per frame. A 0.15
            // chase blend settles 18 * (1 - 0.15) / 0.15 units behind
            // its target. Seed that lag instead of starting too close.
            var startupLag:Vector3D = axisz.clone();
            startupLag.normalize();
            startupLag.scaleBy(150 * 0.12 * (1 - 0.15) / 0.15);
            m.position = m.position.add(startupLag);
         }
         this.blendCamera(m,smooth);
         if(this.gameState != core_gamestate.ENDGAME)
         {
            // Aim from the smoothed position, so initial follow lag cannot
            // push the aircraft outside the view during the countdown.
            var lookAhead:Vector3D = axisz.clone();
            lookAhead.normalize();
            lookAhead.scaleBy(-45);
            var focus:Vector3D = this._player.mtx.position.add(lookAhead);
            this.pointCamera(this.coreInterface.cameraMatrix,focus);
         }
         this.applyCameraMatrix();
      }
      

      private function updateGpuArrow() : void
      {
         var w:Number = stage.stageWidth;
         var h:Number = stage.stageHeight;
         var inverse:Matrix3D = this.coreInterface.cameraMatrix.clone();
         inverse.invert();
         var target:Vector3D = inverse.transformVector(this.ringIndicator.matrix.position);
         // Match the GPU renderer's diagonal FOV and +Z-forward camera.
         var focal:Number = Math.sqrt(w * w + h * h) / (2 * Math.tan(this.coreInterface.camera.fov / 2));
         var front:Boolean = target.z > this.coreInterface.camera.nearClipping;
         var px:Number = w / 2 + focal * target.x / Math.max(0.001,target.z);
         var py:Number = h / 2 + focal * target.y / Math.max(0.001,target.z);
         if(front && px >= 0 && px <= w && py >= 0 && py <= h)
         {
            gfxArrow.alpha = this.coreInterface.lerp(gfxArrow.alpha,0,0.1);
            return;
         }
         var dx:Number = target.x;
         var dy:Number = target.y;
         if(Math.abs(dx) + Math.abs(dy) < 0.00001) dy = 1;
         var angle:Number = Math.atan2(dy,dx) + Math.PI;
         var scale:Number = Math.min(w / 640,h / 400);
         var bounds:Rectangle = gfxArrow.getBounds(gfxArrow);
         var c:Number = Math.cos(angle);
         var sin:Number = Math.sin(angle);
         var halfWidth:Number = (Math.abs(c) * bounds.width + Math.abs(sin) * bounds.height) * scale / 2;
         var halfHeight:Number = (Math.abs(sin) * bounds.width + Math.abs(c) * bounds.height) * scale / 2;
         var insetX:Number = Math.min(w / 2 - 1,halfWidth + 12 * scale);
         var insetY:Number = Math.min(h / 2 - 1,halfHeight + 12 * scale);
         var ray:Number = Math.min((w / 2 - insetX) / Math.max(Math.abs(dx),0.00001),(h / 2 - insetY) / Math.max(Math.abs(dy),0.00001));
         var centerX:Number = (bounds.x + bounds.width / 2) * scale;
         var centerY:Number = (bounds.y + bounds.height / 2) * scale;
         gfxArrow.rotation = angle * 180 / Math.PI;
         gfxArrow.x = w / 2 + dx * ray - (c * centerX - sin * centerY);
         gfxArrow.y = h / 2 + dy * ray - (sin * centerX + c * centerY);
         gfxArrow.alpha = this.coreInterface.lerp(gfxArrow.alpha,1,0.1);
      }

      protected function updateArrow() : void
      {
         if(this.gpuEnabled) { this.updateGpuArrow(); return; }
         var cos:Number = NaN;
         var rim:Number = 50;
         var pos2d:Vector3D = this.coreInterface.camera.projectGlobal(this.ringIndicator.matrix.position);
         if(!(pos2d.x > 0 && pos2d.x < stage.stageWidth && pos2d.y > 0 && pos2d.y < stage.stageHeight) || pos2d.z < 0)
         {
            pos2d.x = this.coreInterface.limit(pos2d.x,rim,stage.stageWidth - rim);
            pos2d.y = this.coreInterface.limit(pos2d.y,rim,stage.stageHeight - rim);
            if(pos2d.z < 0)
            {
               pos2d.x = stage.stageWidth - pos2d.x;
               pos2d.y = stage.stageHeight - pos2d.y;
               if(pos2d.x > rim || pos2d.x < stage.stageWidth - rim)
               {
                  if(rim <= stage.stageWidth / 2)
                  {
                     pos2d.x = rim;
                  }
                  else
                  {
                     pos2d.x = stage.stageWidth - rim;
                  }
               }
               if(pos2d.y > rim || pos2d.y < stage.stageHeight - rim)
               {
                  if(rim <= stage.stageHeight / 2)
                  {
                     pos2d.y = rim;
                  }
                  else
                  {
                     pos2d.y = stage.stageHeight - rim;
                  }
               }
            }
            gfxArrow.alpha = this.coreInterface.lerp(gfxArrow.alpha,1,0.1);
            gfxArrow.x = pos2d.x;
            gfxArrow.y = pos2d.y;
            pos2d.decrementBy(new Vector3D(stage.stageWidth / 2,stage.stageHeight / 2,pos2d.z));
            pos2d.normalize();
            cos = Math.acos(Vector3D.Y_AXIS.dotProduct(pos2d));
            if(Vector3D.X_AXIS.dotProduct(pos2d) > 0)
            {
               cos *= -1;
            }
            gfxArrow.rotation = cos * (180 / Math.PI) - 90;
         }
         else
         {
            gfxArrow.alpha = this.coreInterface.lerp(gfxArrow.alpha,0,0.1);
         }
      }
      
      protected function updateStats(dt:Number) : void
      {
         if(this.gameState == core_gamestate.INGAME)
         {
            this.game_time += dt;
            this.level_time += dt;
         }
         gfxHud.getChildByName("live01").visible = this.lives > 0;
         gfxHud.getChildByName("live02").visible = this.lives > 1;
         gfxHud.getChildByName("live03").visible = this.lives > 2;
         (gfxHud.getChildByName("currentlaptime_text") as TextField).text = this.coreInterface.formatTime(this.level_time);
         (gfxHud.getChildByName("ringsleft") as TextField).text = String(this.checkPoints.length);
      }
      
      protected function onEnterFrame(e:Event) : void
      {
         var tfader:DisplayObject = null;
         var dist:Number = NaN;
         var sfader:DisplayObject = null;
         var act_time:Number = new Date().getTime();
         var dt:Number = (act_time - this.last_time) / 1000;
         this.last_time = act_time;
         if(this.gameState == core_gamestate.UNDEFINED)
         {
            return;
         }
         if(this.gameState == LEVEL_LOADING)
         {
            this.prepareLevelFrame();
            return;
         }         if(this.gameState == core_gamestate.MENUFADEOUT)
         {
            gfxFader.alpha += dt * 2;
            if(gfxFader.alpha >= 1)
            {
               removeChild(gfxFader);
               this.startGame();
            }
            return;
         }
         if(this.gameState == core_gamestate.GAMEFADEIN)
         {
            this.coreInterface.physics.engine.integrate(0.12);
            this._player.update(dt);
            this.updateCamera(0.15);
            this.updateStats(dt);
            if(gfxFader.parent != null)
            {
               gfxFader.alpha -= dt;
               if(gfxFader.alpha <= 0)
               {
                  removeChild(gfxFader);
               }
            }
            if(gfxCount.currentFrame == 90)
            {
               removeChild(gfxCount);
               this.startLampActive = false;
               this.gameState = core_gamestate.INGAME;
               this.updateCamera(1);
            }
         }
         else if(this.gameState == core_gamestate.FRONTEND)
         {
            this.updateCamera(0.1);
            if(scrTitle != null)
            {
               tfader = scrTitle.getChildByName("fader");
               if(tfader.visible)
               {
                  tfader.alpha -= 0.1;
                  if(tfader.alpha <= 0)
                  {
                     tfader.visible = false;
                  }
               }
            }
         }
         else if(this.gameState == core_gamestate.INGAME || this.gameState == core_gamestate.ENDGAME)
         {
            if(!this.coreInterface.paused)
            {
               this.coreInterface.drawSurface.graphics.clear();
               this.coreInterface.physics.engine.integrate(0.12);
               this._player.update(dt);
               this.updateCamera(0.15);
               this.updateStats(dt);
               if(this.gameState == core_gamestate.INGAME)
               {
                  if(this._player.isCrashed())
                  {
                     this.triggerFail(false);
                  }
                  else if(Boolean(this.checkPoints.length))
                  {
                     this.ringIndicator.matrix = this.checkPoints[0];
                     this.ringIndicator.alpha = Math.abs(Math.sin(this._frameCounter * 0.1));
                     this.updateArrow();
                     dist = this.checkPoints[0].position.subtract(this._player.mtx.position).length;
                     if(dist < this.coreInterface._controlPointDistance)
                     {
                        this.checkPoints.shift();
                        if(this.coreInterface.soundEnabled)
                        {
                           this.sndCPPass.playLoadedSound();
                        }
                     }
                     else if(dist > 6000 || this._player.mtx.position.y < 0)
                     {
                        this.triggerFail();
                     }
                  }
                  else
                  {
                     this.triggerEnd();
                  }
               }
               else if(this._fadeOutTime > 0)
               {
                  this._fadeOutTime -= dt;
               }
               else if(!this.gpuEnabled)
               {
                  if(scrStatFail != null)
                  {
                     sfader = scrStatFail.getChildByName("fader");
                  }
                  else if(scrStatWin != null)
                  {
                     sfader = scrStatWin.getChildByName("fader");
                  }
                  else if(scrWin != null)
                  {
                     sfader = scrWin.getChildByName("fader");
                  }
                  if(Boolean(sfader))
                  {
                     if(!sfader.visible)
                     {
                        sfader.visible = true;
                        sfader.alpha = 0;
                     }
                     else
                     {
                        sfader.alpha += dt;
                        if(sfader.alpha > 1)
                        {
                           sfader.alpha = 1;
                        }
                     }
                  }
               }
               if(this.coreInterface.levelDebug)
               {
                  this.coreInterface.drawExcluders();
                  this._player.draw();
               }
            }
         }
         ++this._frameCounter;
         this.renderGameFrame();
      }
   }
