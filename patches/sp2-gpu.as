      private function layoutResponsiveUI() : void
      {
         if(!this.gpuEnabled || stage == null) return;
         var w:Number = stage.stageWidth;
         var h:Number = stage.stageHeight;
         var scale:Number = Math.min(w / 640,h / 400);
         var extra:Number = w / scale - 640;
         var screens:Array = [scrTitle,scrInstructions,scrStatWin,scrStatFail,scrWin,gfxPaused,gfxCount];
         for each(var screen:DisplayObject in screens)
         {
            if(screen == null) continue;
            if(this.uiOriginal[screen] == null) this.uiOriginal[screen] = screen.transform.matrix.clone();
            var m:Matrix = (this.uiOriginal[screen] as Matrix).clone();
            m.scale(scale,scale);
            m.translate((w - 640 * scale) / 2,(h - 400 * scale) / 2);
            screen.transform.matrix = m;
         }
         // Result screens contain their own original five-second blackout.
         // Keep the world visible behind Retry, Continue and the final result.
         for each(var result:Sprite in [scrStatFail,scrStatWin,scrWin])
         {
            if(result == null) continue;
            var resultFade:DisplayObject = result.getChildByName("fader");
            if(resultFade != null) { resultFade.visible = false; resultFade.alpha = 0; }
         }
         gfxHud.scaleX = gfxHud.scaleY = scale;
         gfxHud.x = gfxHud.y = 0;
         for(var i:int = 0; i < gfxHud.numChildren; i++)
         {
            var item:DisplayObject = gfxHud.getChildAt(i);
            if(this.uiOriginal[item] == null) this.uiOriginal[item] = item.transform.matrix.clone();
            var base:Matrix = this.uiOriginal[item] as Matrix;
            var hudMatrix:Matrix = base.clone();
            if(item.name == "live01" || item.name == "live02" || item.name == "live03")
            {
               var iconBounds:Rectangle = item.getBounds(item);
               var iconCenter:Point = new Point(iconBounds.x+iconBounds.width/2,iconBounds.y+iconBounds.height/2);
               var originalCenter:Point = base.transformPoint(iconCenter);
               hudMatrix.a *= 0.9;
               hudMatrix.b *= 0.9;
               hudMatrix.c *= 0.9;
               hudMatrix.d *= 0.9;
               var smallerCenter:Point = hudMatrix.transformPoint(iconCenter);
               hudMatrix.tx += originalCenter.x-smallerCenter.x;
               hudMatrix.ty += originalCenter.y-smallerCenter.y;
            }
            hudMatrix.tx += base.tx > 480 ? extra : (base.tx > 300 ? extra / 2 : 0);
            item.transform.matrix = hudMatrix;
         }
         gfxFader.x = gfxFader.y = 0;
         // Draw exact viewport coverage instead of scaling timeline bounds.
         gfxFader.scaleX = gfxFader.scaleY = 1;
         gfxFader.graphics.clear();
         gfxFader.graphics.beginFill(0x000000);
         gfxFader.graphics.drawRect(0,0,w,h);
         gfxFader.graphics.endFill();
         gfxArrow.scaleX = gfxArrow.scaleY = scale;
      }

