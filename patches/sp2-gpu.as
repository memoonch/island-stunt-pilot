      private function drawButtonLettering(face:Sprite,label:String,x:Number,y:Number,color:uint = 0x062E44) : void
      {
         var info:Array = BUTTON_LETTERING[label];
         var commands:Array = info[2];
         var g:Graphics = face.graphics;
         g.lineStyle();
         g.beginFill(color);
         var i:int = 0;
         while(i < commands.length)
         {
            var type:int = commands[i++];
            if(type == 0) g.moveTo(x + commands[i++],y + commands[i++]);
            else if(type == 1) g.lineTo(x + commands[i++],y + commands[i++]);
            else g.curveTo(x + commands[i++],y + commands[i++],x + commands[i++],y + commands[i++]);
         }
         g.endFill();
      }
      // END BUTTON LETTERING

      private function makeIslandButton(label:String,primary:Boolean,icon:String = "") : SimpleButton
      {
         var hit:Sprite = new Sprite();
         hit.graphics.beginFill(0);
         hit.graphics.drawRoundRect(0,0,250,54,20,20);
         hit.graphics.endFill();
         return new SimpleButton(this.islandButtonState(label,primary,0,icon),this.islandButtonState(label,primary,1,icon),this.islandButtonState(label,primary,2,icon),hit);
      }

      private function islandButtonState(label:String,primary:Boolean,state:int,icon:String = "") : Sprite
      {
         var face:Sprite = new Sprite();
         var down:Boolean = state == 2;
         var hover:Boolean = state == 1;
         var y:Number = down ? 3 : 0;
         var matrix:Matrix = new Matrix();
         // Static vector states stay crisp at every viewport size.
         face.graphics.beginFill(0x061927,0.65);
         face.graphics.drawRoundRect(0,5,250,54,20,20);
         face.graphics.endFill();
         face.graphics.lineStyle(2,hover ? 0xE5FFFF : 0x07364B);
         face.graphics.beginFill(primary ? 0xA94A05 : 0x005370);
         face.graphics.drawRoundRect(0,y,250,54,20,20);
         face.graphics.endFill();
         matrix.createGradientBox(246,48,Math.PI / 2,2,y+2);
         var colors:Array = primary ? (hover ? [0xFFF382,0xFFAF22] : [0xFFE66A,0xFF9214]) : (hover ? [0x91F6FF,0x06BBDD] : [0x50E4F5,0x008FBA]);
         if(down) colors = primary ? [0xF4B42D,0xF07810] : [0x12BCD5,0x007C9F];
         face.graphics.lineStyle();
         face.graphics.beginGradientFill(GradientType.LINEAR,colors,[1,1],[0,255],matrix);
         face.graphics.drawRoundRect(2,y+2,246,48,17,17);
         face.graphics.endFill();
         face.graphics.lineStyle(1,0xFFFFFF,down ? 0.2 : 0.6);
         face.graphics.drawRoundRect(4,y+4,242,44,14,14);
         face.graphics.lineStyle();
         face.graphics.beginFill(0x062E44);
         if(icon == "none")
         {
            // Navigation labels are centered without a competing icon column.
         }
         else if(icon == "mouse")
         {
            face.graphics.endFill();
            face.graphics.lineStyle(2.5,0x062E44,1,true);
            face.graphics.drawRoundRect(18,y+12,20,29,18,18);
            face.graphics.moveTo(18,y+25);
            face.graphics.lineTo(38,y+25);
            face.graphics.moveTo(28,y+13);
            face.graphics.lineTo(28,y+25);
            face.graphics.lineStyle();
            face.graphics.beginFill(0x062E44);
            face.graphics.drawRoundRect(26.5,y+17,3,6,3,3);
         }
         else if(icon == "keyboard")
         {
            face.graphics.drawRoundRect(13,y+15,30,23,6,6);
            face.graphics.endFill();
            face.graphics.beginFill(0xFFDD60);
            for(var ky:int=0;ky<2;ky++) for(var kx:int=0;kx<4;kx++) face.graphics.drawRoundRect(17+kx*6,y+19+ky*6,4,4,1,1);
            face.graphics.drawRoundRect(20,y+32,16,3,1,1);
         }
         else if(icon == "off" || icon == "on")
         {
            face.graphics.drawRoundRect(15,y+17,30,19,19,19);
            face.graphics.endFill();
            face.graphics.beginFill(0xF2FFFF);
            face.graphics.drawCircle(icon == "on" ? 35 : 25,y+26.5,6.5);
         }
         else if(icon == "retry")
         {
            face.graphics.endFill();
            face.graphics.lineStyle(3,0x062E44,1,true);
            face.graphics.moveTo(36,y+19);
            face.graphics.curveTo(23,y+9,17,y+23);
            face.graphics.curveTo(12,y+38,29,y+39);
            face.graphics.curveTo(40,y+39,40,y+28);
            face.graphics.lineStyle();
            face.graphics.beginFill(0x062E44);
            face.graphics.moveTo(29,y+20);
            face.graphics.lineTo(39,y+23);
            face.graphics.lineTo(38,y+13);
         }
         else if(primary)
         {
            var arrowX:Number = label == "PLAY" ? 69 : 22;
            face.graphics.moveTo(arrowX,y+17);
            face.graphics.lineTo(arrowX,y+35);
            face.graphics.lineTo(arrowX+16,y+26);
            face.graphics.lineTo(arrowX,y+17);
         }
         else
         {
            for(var row:int=0;row<2;row++) for(var col:int=0;col<2;col++) face.graphics.drawRoundRect(18+col*9,y+19+row*9,6,6,2,2);
         }
         face.graphics.endFill();
         var lettering:Array = BUTTON_LETTERING[label];
         var labelX:Number = label == "PLAY" ? 96 : (icon == "on" || icon == "off" ? 53 : 48);
         if(icon == "none") labelX = (250-Number(lettering[0]))/2;
         this.drawButtonLettering(face,label,labelX,y+(50-Number(lettering[1]))/2);
         face.mouseChildren = false;
         return face;
      }
      
