      private function processInstructions(create:Boolean) : void
      {
         if(create)
         {
            scrInstructions = new scr_instructions() as Sprite;
            addChild(scrInstructions);
            if(this.gpuEnabled) this.themeControlButtons();
            scrInstructions.getChildByName("btn_continue_mouse").addEventListener(MouseEvent.CLICK,this.onPlayGameMouse);
            scrInstructions.getChildByName("btn_continue_keyboard").addEventListener(MouseEvent.CLICK,this.onPlayGameKeyboard);
            scrInstructions.getChildByName("btn_invert").addEventListener(MouseEvent.CLICK,this.onInvertY);
            scrInstructions.getChildByName("btn_inverted").addEventListener(MouseEvent.CLICK,this.onInvertY);
            this.updateInvertY();
         }
         else
         {
            removeChild(scrInstructions);
            scrInstructions = null;
            this.removeModels();
         }
      }
      
      private function removeModels() : void
      {
         if(this.coreInterface.sceneRoot is BSPContainer) (this.coreInterface.sceneRoot as BSPContainer).destroyTree();
         while(Boolean(this.models.length))
         {
            if(this.models[this.models.length - 1].parent == this.coreInterface.sceneRoot) this.coreInterface.sceneRoot.removeChild(this.models[this.models.length - 1]);
            this.models[this.models.length - 1] = null;
            this.models.pop();
         }
      }
      
      private function themeControlButtons() : void
      {
         // This symbol contains only the old controls and their two subtitles.
         // The instruction board itself is part of the 3D world behind it.
         while(scrInstructions.numChildren > 0) scrInstructions.removeChildAt(0);
         var mouse:SimpleButton = this.makeIslandButton("MOUSE CONTROL",false,"mouse");
         mouse.name = "btn_continue_mouse";
         mouse.x = 45;
         mouse.y = 332;
         scrInstructions.addChild(mouse);
         var keyboard:SimpleButton = this.makeIslandButton("KEYBOARD CONTROL",true,"keyboard");
         keyboard.name = "btn_continue_keyboard";
         keyboard.x = 345;
         keyboard.y = 332;
         scrInstructions.addChild(keyboard);
         var off:SimpleButton = this.makeIslandToggle(false);
         off.name = "btn_invert";
         off.x = 195;
         off.y = 263;
         scrInstructions.addChild(off);
         var on:SimpleButton = this.makeIslandToggle(true);
         on.name = "btn_inverted";
         on.x = 195;
         on.y = 263;
         scrInstructions.addChild(on);
      }

      private function updateInvertY() : void
      {
         for each(var screen:Sprite in [scrInstructions,gfxPaused])
         {
            if(screen == null) continue;
            var off:DisplayObject = screen.getChildByName("btn_invert");
            var on:DisplayObject = screen.getChildByName("btn_inverted");
            if(off != null) off.visible = this._invertYAxis != 1;
            if(on != null) on.visible = this._invertYAxis == 1;
         }
         this._player.setInvertY(this._invertYAxis);
      }
      
      private function onInvertY(e:MouseEvent) : void
      {
         this._invertYAxis *= -1;
         this.updateInvertY();
      }
      
      private function onPlayGameMouse(e:MouseEvent) : void
      {
         this.mouseControl = true;
         this.processInstructions(false);
         this.reset();
         this.prepareFadeToBlack();
         this.gameState = core_gamestate.MENUFADEOUT;
      }
      
      private function onPlayGameKeyboard(e:MouseEvent) : void
      {
         this.mouseControl = false;
         this.processInstructions(false);
         this.reset();
         this.prepareFadeToBlack();
         this.gameState = core_gamestate.MENUFADEOUT;
      }
      
