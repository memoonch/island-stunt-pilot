      private function toggleWidgetState(on:Boolean,hover:Boolean) : Sprite
      {
         var widget:Sprite = new Sprite();
         // Flat settings row keeps the label readable over the instruction board.
         // No bevel, button shadow or navigation styling.
         widget.graphics.beginFill(0x0A2838,0.98);
         widget.graphics.drawRoundRect(-8,1,266,42,8,8);
         widget.graphics.endFill();
         this.drawButtonLettering(widget,"INVERT Y AXIS",0,15,0xA4EBEF);
         var stateLabel:String = on ? "ON" : "OFF";
         var state:Sprite = new Sprite();
         this.drawButtonLettering(state,stateLabel,0,0,on ? 0x68E3DA : 0x84B3BE);
         state.scaleX = state.scaleY = 0.7;
         state.x = 180-Number(BUTTON_LETTERING[stateLabel][0])*0.7/2;
         state.y = 18;
         widget.addChild(state);
         widget.graphics.lineStyle(hover ? 2 : 1,hover ? 0xA2FFFF : 0x45BEBB);
         widget.graphics.beginFill(on ? 0x138E8B : 0x20545E);
         widget.graphics.drawRoundRect(201,9,48,26,26,26);
         widget.graphics.endFill();
         widget.graphics.lineStyle();
         widget.graphics.beginFill(0xE8FFFF);
         widget.graphics.drawCircle(on ? 236 : 214,22,9);
         widget.graphics.endFill();
         widget.mouseChildren = false;
         return widget;
      }

      private function makePausePanel() : Sprite
      {
         var panel:Sprite = this.islandPanel("PAUSED");
         this.panelButton(panel,"btn_resume","RESUME",true,94).addEventListener(MouseEvent.CLICK,this.onPauseResume);
         this.panelButton(panel,"btn_retry","RETRY",false,162,"retry");
         this.panelButton(panel,"btn_mainmenu","BACK TO MENU",false,230);
         panel.graphics.lineStyle(1,0x65D5E1,0.25);
         panel.graphics.moveTo(195,301);
         panel.graphics.lineTo(445,301);
         panel.graphics.lineStyle();
         var off:SimpleButton = this.makeIslandToggle(false);
         off.name = "btn_invert";
         off.x = 195;
         off.y = 312;
         off.addEventListener(MouseEvent.CLICK,this.onInvertY);
         panel.addChild(off);
         var on:SimpleButton = this.makeIslandToggle(true);
         on.name = "btn_inverted";
         on.x = 195;
         on.y = 312;
         on.addEventListener(MouseEvent.CLICK,this.onInvertY);
         panel.addChild(on);
         panel.getChildByName("btn_invert").visible = this._invertYAxis != 1;
         panel.getChildByName("btn_inverted").visible = this._invertYAxis == 1;
         return panel;
      }

      private function onPauseResume(e:MouseEvent) : void
      {
         if(this.coreInterface.paused) this.togglePause();
      }

      private function vectorValue(panel:Sprite,label:String,value:String,y:Number) : void
      {
         var labelInfo:Array = BUTTON_LETTERING[label];
         this.drawButtonLettering(panel,label,320-Number(labelInfo[0])/2,y,0x81D9E8);
         var number:Sprite = new Sprite();
         var x:Number = 0;
         for(var i:int=0;i<value.length;i++)
         {
            var ch:String = value.charAt(i);
            if(BUTTON_LETTERING[ch] == null) continue;
            this.drawButtonLettering(number,ch,x,ch == ":" ? (13-Number(BUTTON_LETTERING[ch][1]))/2 : 0,0xFFFFFF);
            x += 13;
         }
         number.scaleX = number.scaleY = 1.35;
         number.x = 320-(x-4)*1.35/2;
         number.y = y+25;
         panel.addChild(number);
      }

      private function makeResultPanel(kind:String) : Sprite
      {
         var title:String = kind == "level" ? "LEVEL COMPLETE" : (kind == "win" ? "ADVENTURE COMPLETE" : (this.lives > 1 ? "TRY AGAIN" : "GAME OVER"));
         var panel:Sprite = this.islandPanel(title);
         // Preserve named fields used by the original result bookkeeping.
         for each(var fieldName:String in ["overall_time","average_time"])
         {
            var field:TextField = new TextField();
            field.name = fieldName;
            field.visible = false;
            panel.addChild(field);
         }
         if(kind == "win")
         {
            this.vectorValue(panel,"TOTAL TIME",this.coreInterface.formatTime(this.game_time),115);
            this.vectorValue(panel,"AVERAGE TIME",this.coreInterface.formatTime(this.game_time/12),190);
         }
         else this.vectorValue(panel,"TIME",this.coreInterface.formatTime(this.level_time),145);
         this.panelButton(panel,kind == "fail" ? "btn_retry" : "btn_continue",kind == "fail" ? (this.lives > 1 ? "RETRY" : "BACK TO MENU") : "CONTINUE",kind != "fail",285);
         return panel;
      }

      private function processStatScreen(create:Boolean) : void
      {
         if(this._levelSuccess)
         {
            if(create)
            {
               scrStatWin = this.gpuEnabled ? this.makeResultPanel("level") : new this.scr_stat_win() as Sprite;
               addChild(scrStatWin);
               scrStatWin.getChildByName("btn_continue").addEventListener(MouseEvent.CLICK,this.onContinueFromStat);
               this.removeStoreButtons(scrStatWin);
               scrStatWin.getChildByName("fader").visible = false;
               scrStatWin.getChildByName("fader").alpha = 0;
               (scrStatWin.getChildByName("overall_time") as TextField).text = this.coreInterface.formatTime(this.level_time);
               this._fadeOutTime = 5;
            }
            else
            {
               removeChild(scrStatWin);
               scrStatWin = null;
            }
         }
         else if(create)
         {
            scrStatFail = this.gpuEnabled ? this.makeResultPanel("fail") : new this.scr_stat_fail() as Sprite;
            addChild(scrStatFail);
            scrStatFail.getChildByName("btn_retry").addEventListener(MouseEvent.CLICK,this.onRetryFromStat);
            this.removeStoreButtons(scrStatFail);
            scrStatFail.getChildByName("fader").visible = false;
            scrStatFail.getChildByName("fader").alpha = 0;
            this._fadeOutTime = 5;
         }
         else
         {
            removeChild(scrStatFail);
            scrStatFail = null;
         }
      }
      
      private function onContinueFromStat(e:MouseEvent) : void
      {
         this.processStatScreen(false);
         ++this.levelNum;
         this.stopGame(false);
         this.startGame();
      }
      
      private function onRetryFromStat(e:MouseEvent) : void
      {
         this.processStatScreen(false);
         if(Boolean(this.lives))
         {
            this.stopGame(false);
            this.startGame();
         }
         else
         {
            this.stopGame(true);
         }
      }
      
      private function processWin(create:Boolean) : void
      {
         if(create)
         {
            this._gameSuccess = true;
            scrWin = this.gpuEnabled ? this.makeResultPanel("win") : new scr_win() as Sprite;
            addChild(scrWin);
            scrWin.getChildByName("btn_continue").addEventListener(MouseEvent.CLICK,this.onFinishGame);
            this.removeStoreButtons(scrWin);
            (scrWin.getChildByName("average_time") as TextField).text = this.coreInterface.formatTime(this.game_time / 12);
            (scrWin.getChildByName("overall_time") as TextField).text = this.coreInterface.formatTime(this.game_time);
            this.Fog.submitScore(this.game_time);
            this._fadeOutTime = 5;
         }
         else
         {
            removeChild(scrWin);
            scrWin = null;
         }
      }
      
      private function onFinishGame(e:MouseEvent) : void
      {
         this.processWin(false);
         this.levelNum = 0;
         this.stopGame(true);
      }
      
